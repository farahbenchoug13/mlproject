# Copy to .env and fill in. .env is gitignored — never commit or share your keys.
# All optional and free. The captioner tries them in this order; with none, it uses offline templates.
GROQ_API_KEY=          # https://console.groq.com/keys          (default model: openai/gpt-oss-120b)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey     (default model: gemini-flash-lite-latest)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys             (default model: openai/gpt-oss-120b:free)
# Optional model overrides, e.g.:
# CAPTION_MODEL_GROQ=openai/gpt-oss-120b
